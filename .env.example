# ─── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── Database (PostgreSQL via Prisma) ───────────────────────
DATABASE_URL="postgresql://username:password@ep-host-name.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_very_long_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── SMTP / Nodemailer ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Volunteer Platform <no-reply@volunteerplatform.pk>"

# ─── Local Storage (AWS S3 not needed for now) ──────────────
# Files are stored in the local "/uploads" directory.
# (If you decide to switch back to S3 later, restore AWS credentials here)

# ─── Payment Gateways ───────────────────────────────────────
SAFE_PAY_API_KEY=
SAFE_PAY_MERCHANT_SECRET=
SAFE_PAY_BASE_URL=
SAFE_PAY_CHECKOUT_PATH=/api/checkout/v2/session
SAFE_PAY_WEBHOOK_URL=https://your-public-api.example.com/api/v1/webhooks/safepay
SAFE_PAY_WEBHOOK_ID=
SAFE_PAY_WEBHOOK_SECRET=

# ─── Geofence ───────────────────────────────────────────────
DEFAULT_GEOFENCE_RADIUS_METERS=200

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Passport Certificate ───────────────────────────────────
PASSPORT_PRIVATE_KEY_PATH=./keys/passport_private.pem
PASSPORT_PUBLIC_KEY_PATH=./keys/passport_public.pem
