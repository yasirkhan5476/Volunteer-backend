# ─── Upstash Redis Configuration ───────────────────────────
# Replace with your actual connection host, port, and password from Upstash:
REDIS_HOST="huge-collie-117845.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="gQAAAAAAAcxVAAIgcDFiMGE2M2IxMTU1NDg0ZWUwYjJmMTI3ZjIxYzM4ZjI3Nw"
# IMPORTANT: BullMQ requires Redis not to evict queued jobs.
# Upstash/managed Redis must be configured with maxmemory-policy=noeviction.
REDIS_MAXMEMORY_POLICY="noeviction"

# ─── JSON Web Token (JWT) Security ──────────────────────────
